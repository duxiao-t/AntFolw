FROM eclipse-temurin:17-jre-jammy AS backend

# 与 Dockerfile.local 一致：水印依赖 ffmpeg + 中文字体（wqy 路径已在候选列表里）。
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-wqy-microhei \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/target/antflow-backend-0.1.0-SNAPSHOT.jar app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

FROM nginx:1.28-alpine AS web

COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY frontend/dist-test/ /usr/share/nginx/html/
COPY mobile/dist-test/ /usr/share/nginx/html/mobile/
RUN grep -q "antflow-test-csrf" /usr/share/nginx/html/*.js \
    && grep -R -q "antflow-test-csrf" /usr/share/nginx/html/mobile/assets/ \
    && ! grep -R -q "antflow-csrf=" /usr/share/nginx/html/
EXPOSE 80
